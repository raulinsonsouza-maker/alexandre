# Produção — bestoneacademy.com.br (VPS 158.173.2.125, Traefik Easypanel)
# Copiar para /opt/apps/alexandre/.env e preencher secrets na VPS.

POSTGRES_USER=alexandre
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=jornada_ewm
DATABASE_URL=postgresql://alexandre:CHANGE_ME_STRONG_PASSWORD@db:5432/jornada_ewm?schema=public

AUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
NEXTAUTH_URL=https://bestoneacademy.com.br
AUTH_TRUST_HOST=true

APP_ENV=production
APP_VERSION=0.1.0
APP_PUBLIC_URL=https://bestoneacademy.com.br

PAYMENT_PROVIDER=mercadopago
EMAIL_PROVIDER=log

# Traefik Easypanel (rede overlay attachable)
TRAEFIK_NETWORK=easypanel
TRAEFIK_ENTRYPOINT_HTTP=http
TRAEFIK_ENTRYPOINT_HTTPS=https
TRAEFIK_CERT_RESOLVER=letsencrypt
PUBLIC_HOST=bestoneacademy.com.br

# Mercado Pago Checkout Transparente — preencha na VPS, nunca no Git
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Cakto — rollback (PAYMENT_PROVIDER=cakto)
# Escopos: read, write, products, offers, orders, webhooks, card_tokens, payments
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
CAKTO_WEBHOOK_SECRET=
NEXT_PUBLIC_CAKTO_CLIENT_ID=
CAKTO_API_BASE=https://api.cakto.com.br/public_api
