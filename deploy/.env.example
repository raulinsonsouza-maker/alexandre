POSTGRES_USER=alexandre
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=jornada_ewm
DATABASE_URL=postgresql://alexandre:CHANGE_ME_STRONG_PASSWORD@db:5432/jornada_ewm?schema=public

AUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
NEXTAUTH_URL=https://alexandre.symbius.com.br
AUTH_TRUST_HOST=true

APP_ENV=production
APP_VERSION=0.1.0
PAYMENT_PROVIDER=demo
EMAIL_PROVIDER=log

# Traefik — Hetzner (padrão). Bestone: use deploy/.env.bestone.example
TRAEFIK_NETWORK=traefik_proxy
TRAEFIK_ENTRYPOINT_HTTP=web
TRAEFIK_ENTRYPOINT_HTTPS=websecure
TRAEFIK_CERT_RESOLVER=letsencryptresolver
PUBLIC_HOST=alexandre.symbius.com.br

