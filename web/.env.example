# PostgreSQL local — ajuste a porta se necessário
# PG 17 neste ambiente: 5433 | PG 16: 5432
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/jornada_ewm?schema=public"

AUTH_SECRET="troque-em-producao"
NEXTAUTH_URL="http://localhost:3000"

APP_ENV="development"
APP_VERSION="0.1.0"

PAYMENT_PROVIDER="demo"
EMAIL_PROVIDER="log"

