generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum EnrollmentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  PIX
  CARD
  BOLETO
  MANUAL
  COUPON
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  phone             String?
  passwordHash      String
  role              Role      @default(STUDENT)
  active            Boolean   @default(true)
  emailVerified     DateTime?
  mustResetPassword Boolean   @default(false)
  company           String?
  jobTitle          String?
  city              String?
  state             String?
  country           String?   @default("Brasil")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  enrollments    Enrollment[]
  orders         Order[]
  progress       LessonProgress[]
  certificates   Certificate[]
  consents       Consent[]
  auditLogs      AuditLog[]           @relation("AuditActor")
  passwordResets PasswordResetToken[]

  @@index([role])
  @@index([active])
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  published   Boolean  @default(false)
  priceCents  Int      @default(56000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules      Module[]
  enrollments  Enrollment[]
  orderItems   OrderItem[]
  certificates Certificate[]
}

model Module {
  id             String   @id @default(cuid())
  courseId       String
  code           String
  slug           String   @unique
  title          String
  description    String?
  sortOrder      Int      @default(0)
  published      Boolean  @default(false)
  priceCents     Int      @default(31779)
  coverPath      String?
  category       String?
  featured       Boolean  @default(false)
  featuredOrder  Int      @default(0)
  caktoProductId String?
  caktoOfferId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  enrollments Enrollment[]
  planModules PlanModule[]
  orderItems  OrderItem[]
  certificates Certificate[]

  @@unique([courseId, code])
  @@index([published, sortOrder])
  @@index([featured, featuredOrder])
  @@index([category])
}

model Lesson {
  id            String   @id @default(cuid())
  moduleId      String
  title         String
  description   String?
  contentKey    String?
  sortOrder     Int      @default(0)
  published     Boolean  @default(false)
  videoUrl      String?
  videoPath     String?
  durationSec   Int?
  isFreePreview Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  module    Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  materials Material[]
  progress  LessonProgress[]

  @@index([moduleId, sortOrder])
}

model Material {
  id        String   @id @default(cuid())
  lessonId  String
  title     String
  filePath  String
  mimeType  String?
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Plan {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  goal            String?
  priceCents      Int      @default(0)
  badge           String?
  bullets         Json?
  sortOrder       Int      @default(0)
  published       Boolean  @default(true)
  checkoutEnabled Boolean  @default(true)
  ctaUrl          String?
  caktoProductId  String?
  caktoOfferId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modules     PlanModule[]
  enrollments Enrollment[]
  orderItems  OrderItem[]
}

model PlanModule {
  id       String @id @default(cuid())
  planId   String
  moduleId String

  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([planId, moduleId])
  @@index([moduleId])
}

model Enrollment {
  id        String           @id @default(cuid())
  userId    String
  courseId  String?
  moduleId  String?
  planId    String?
  status    EnrollmentStatus @default(ACTIVE)
  source    String           @default("manual")
  grantedBy String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  plan   Plan?   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([courseId])
  @@index([moduleId])
  @@index([planId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  positionSec Int       @default(0)
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Certificate {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  moduleId  String
  code      String   @unique
  issuedAt  DateTime @default(now())
  pdfPath   String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId, courseId])
}

model Order {
  id               String        @id @default(cuid())
  userId           String
  status           OrderStatus   @default(PENDING)
  paymentMethod    PaymentMethod @default(MANUAL)
  totalCents       Int
  currency         String        @default("BRL")
  couponCode       String?
  gateway          String?
  gatewayPaymentId String?
  gatewayPayload   Json?
  idempotencyKey   String?       @unique
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([userId, status])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  courseId   String?
  planId     String?
  moduleId   String?
  title      String
  priceCents Int
  quantity   Int     @default(1)

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  plan   Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)
  module Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  percentOff      Int?
  amountOffCents  Int?
  active          Boolean   @default(true)
  maxRedemptions  Int?
  redemptionCount Int       @default(0)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Consent {
  id        String   @id @default(cuid())
  userId    String
  type      String
  version   String
  accepted  Boolean  @default(true)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model SiteBanner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imagePath String?
  linkUrl   String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  body        String
  coverPath   String?
  category    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([category])
}
